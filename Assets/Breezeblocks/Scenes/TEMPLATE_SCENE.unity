  rewiredPlayerId: 0
  toggleConsoleAction: ToggleConsole
  keyboardToggleConsoleFallbackKey: 96
  playerRoot: {fileID: 457326117}
  playerMotor: {fileID: 457326118}
  playerVisionLight: {fileID: 0}
  playerEquipmentController: {fileID: 457326130}
  playerWeaponController: {fileID: 457326123}
  playerUtilityController: {fileID: 457326129}
  playerMeleeController: {fileID: 457326137}
  playerPickupInteractor: {fileID: 457326141}
  playerFocusController: {fileID: 457326142}
  playerStaminaController: {fileID: 457326135}
  playerHealth: {fileID: 457326122}
  globalLight2D: {fileID: 619394801}
  showSystemTime: 1
