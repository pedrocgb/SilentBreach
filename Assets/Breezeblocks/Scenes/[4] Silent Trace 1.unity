  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Breezeblocks.Missions.GameplayConsoleController
  rewiredPlayerId: 0
  toggleConsoleAction: ToggleConsole
  commandHistoryVerticalAction: Move Vertical
  commandHistoryAxisThreshold: 0.5
  keyboardToggleConsoleFallbackKey: 96
  playerRoot: {fileID: 457326117}
  playerMotor: {fileID: 457326118}
  playerVisionLight: {fileID: 0}
  playerEquipmentController: {fileID: 457326130}
  playerWeaponController: {fileID: 457326123}
  playerUtilityController: {fileID: 457326129}
  playerMeleeController: {fileID: 457326137}
  playerPickupInteractor: {fileID: 457326141}
  playerFocusController: {fileID: 457326142}
  playerStaminaController: {fileID: 457326135}
  playerHealth: {fileID: 457326122}
  globalLight2D: {fileID: 619394801}
  showSystemTime: 1
  pauseGameplayWhileOpen: 0
  maxLogEntries: 128
  commandHelpEntries:
  - commandId: help
    commandSyntax: help
    description: Lists all available console commands and what they do.
  - commandId: create_equipment
    commandSyntax: create_equipment_EQUIPMENTNAME
    description: Creates equipment by its display name and stores it in the player's
      equipment slots.
  - commandId: god_mode
    commandSyntax: god_mode true|false
    description: Turns player invincibility on or off.
  - commandId: invisible
    commandSyntax: invisible true|false
    description: Disables enemy vision detection against the player.
  - commandId: lightfooted
    commandSyntax: lightfooted true|false
    description: Disables enemy hearing reactions.
  - commandId: restart_level
    commandSyntax: restart_level
    description: Reloads the current level.
  - commandId: noclip
    commandSyntax: noclip true|false
    description: Gives infinite reserve ammo and throwable uses.
  - commandId: focus_mode
    commandSyntax: focus_mode true|false
    description: Restores focus to full and prevents focus from draining.
  - commandId: athlete_mode
    commandSyntax: athlete_mode true|false
    description: Restores stamina to full and prevents stamina from draining.
  - commandId: ghost_mode
    commandSyntax: ghost_mode true|false
    description: Disables the player's solid colliders so the player can pass through
      obstacles.
  - commandId: medusa_mode
    commandSyntax: medusa_mode true|false
    description: Turns the player vision cone into a 360 degree view or restores
      the default cone.
  - commandId: let_there_be_light
    commandSyntax: let_there_be_light true|false
    description: Enables or disables the _GLOBALLIGHT Light2D.
  - commandId: add_perk
    commandSyntax: add_perk PERKNAME
    description: Equips a perk by ScriptableObject perk name without respecting the
      normal perk slot cap.
  - commandId: no_failures
    commandSyntax: no_failures true|false
    description: Prevents job failure rules from ending the mission.
  - commandId: win_game
    commandSyntax: win_game
    description: Completes all mission objectives but still requires entering the
      exit zone.
  - commandId: instant_lockpicking
    commandSyntax: instant_lockpicking true|false
    description: Makes any started lockpicking attempt succeed immediately without
      lockpicks.
  - commandId: infinite_lockpicks
    commandSyntax: infinite_lockpicks true|false
    description: Lets lockpicking start without lockpicks and prevents lockpick use
      consumption.
  - commandId: unlock_all
    commandSyntax: unlock_all
    description: Unlocks every locked door in the current scene.
  - commandId: show_active_cheats
    commandSyntax: show_active_cheats
    description: Lists active toggle cheats and command use counts.
  consoleCanvas: {fileID: 1177612884}
  consoleRoot: {fileID: 0}
  logText: {fileID: 0}
  systemTimeText: {fileID: 0}
  commandInputField: {fileID: 0}
  logScrollRect: {fileID: 0}
  logScrollbar: {fileID: 0}
