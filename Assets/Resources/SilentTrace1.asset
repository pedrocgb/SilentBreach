    failureScreenMessage: "Assassinato era pro\xEDbido..."
    timeLimitSeconds: 300
  - failureType: 2
    displayText: "N\xE3o machuque ningu\xE9m"
    failureScreenMessage: "Ferir pessoas era pro\xEDbido..."
    timeLimitSeconds: 300
  - failureType: 5
    displayText: "N\xE3o seja detectado."
    failureScreenMessage: "Voc\xEA foi detectado..."
    timeLimitSeconds: 300
  - failureType: 4
    displayText: "N\xE3o alerte ningu\xE9m."
    failureScreenMessage: "Voc\xEA alertou as pessoas de sua presen\xE7a..."
    timeLimitSeconds: 300
  fixerName: Alana Poatan
